# ==========================================
# Solvex Backend - Hostinger Production .env
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random 32+ character string)
JWT_SECRET=your_super_secret_production_jwt_key_here_change_me
JWT_EXPIRES_IN=7d

# Hostinger MySQL Database Settings
# Note: In Hostinger hPanel -> Databases -> MySQL Databases:
# Database Name and User usually look like: u123456789_solvex
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_solvex_user
DB_PASSWORD=YourHostingerDbPasswordHere
DB_NAME=u123456789_solvex_db

# Public URL of your Backend API (No trailing slash)
# Example: https://api.solvexgloballtd.com
APP_URL=https://api.solvexgloballtd.com

# Allowed Frontend Origins for CORS (Comma separated or * for all)
# Example: https://solvexgloballtd.com,https://admin.solvexgloballtd.com
CORS_ORIGIN=*

# ==========================================
# Persistent Uploads Storage (IMPORTANT)
# ==========================================
# Set this outside the Git repo directory so 'git push', 'git pull', and builds
# will NEVER delete or overwrite your uploaded images and PDFs.
# Example: ../uploads_storage (stores in a safe sibling directory outside the git repo)
UPLOADS_DIR=../uploads_storage

# ==========================================
# Optional: Cloudinary Permanent Cloud CDN Storage
# ==========================================
# If configured, all uploaded images are automatically hosted on Cloudinary CDN
# and will NEVER disappear regardless of server reinstalls, restarts, or rebuilds.
# Sign up free at https://cloudinary.com (Free 25GB)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
